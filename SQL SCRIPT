--  SISTEMA ARARA AZUL: GESTÃO ESCOLAR INTEGRADA
CREATE DATABASE IF NOT EXISTS arara_azul;
USE arara_azul;

-- 1. NÚCLEO PESSOA
CREATE TABLE tb_pessoa (
    pk_id_pessoa    INT          NOT NULL AUTO_INCREMENT,
    cpf              CHAR(11)     NOT NULL,
    rg               VARCHAR(15),
    nome             VARCHAR(150) NOT NULL, -- Ajustado para o diagrama
    sobrenome        VARCHAR(150),          -- Ajustado para o diagrama
    data_nascimento  DATE NOT NULL,
    criado_em        TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_pessoa     PRIMARY KEY (pk_id_pessoa),
    CONSTRAINT uq_pessoa_cpf UNIQUE (cpf)
);

-- 2. LOCALIZAÇÃO E CONTATOS
CREATE TABLE tb_telefone (
    pk_id_telefone INT          NOT NULL AUTO_INCREMENT,
    fk_id_pessoa   INT          NOT NULL,
    ddd            CHAR(2)      NOT NULL,
    numero         VARCHAR(15)  NOT NULL,
    CONSTRAINT pk_telefone PRIMARY KEY (pk_id_telefone),
    CONSTRAINT fk_tel_pessoa FOREIGN KEY (fk_id_pessoa) 
        REFERENCES tb_pessoa (pk_id_pessoa) ON DELETE CASCADE
);

-- 3. RECURSOS HUMANOS
CREATE TABLE tb_cargo (
    pk_id_cargo INT          NOT NULL AUTO_INCREMENT,
    nome_cargo  VARCHAR(80)  NOT NULL,
    CONSTRAINT pk_cargo PRIMARY KEY (pk_id_cargo)
);

CREATE TABLE tb_funcionario (
    pk_id_funcionario INT  NOT NULL AUTO_INCREMENT,
    fk_id_pessoa      INT  NOT NULL,
    fk_id_cargo       INT  NOT NULL,
    data_admissao     DATE NOT NULL,
    salario_base      DECIMAL(10,2) NOT NULL,
    CONSTRAINT pk_funcionario PRIMARY KEY (pk_id_funcionario),
    CONSTRAINT fk_func_pessoa FOREIGN KEY (fk_id_pessoa) REFERENCES tb_pessoa (pk_id_pessoa),
    CONSTRAINT fk_func_cargo  FOREIGN KEY (fk_id_cargo)  REFERENCES tb_cargo (pk_id_cargo)
);

-- 4. ESTRUTURA ACADÊMICA
CREATE TABLE tb_turma (
    pk_id_turma     INT      NOT NULL AUTO_INCREMENT,
    nome_turma      VARCHAR(150) NOT NULL,
    ano_letivo      INT      NOT NULL,
    CONSTRAINT pk_turma PRIMARY KEY (pk_id_turma)
);

-- 5. GESTÃO DE ALUNOS
CREATE TABLE tb_aluno (
    ra               VARCHAR(20) NOT NULL,
    fk_id_pessoa     INT         NOT NULL,
    data_ingresso    DATE        NOT NULL,
    CONSTRAINT pk_aluno PRIMARY KEY (ra),
    CONSTRAINT fk_aluno_pessoa FOREIGN KEY (fk_id_pessoa) REFERENCES tb_pessoa (pk_id_pessoa)
);

-- 6. MATRÍCULA E FINANCEIRO (AJUSTADA)
CREATE TABLE tb_matricula (
    pk_id_matricula  INT  NOT NULL AUTO_INCREMENT,
    fk_ra_aluno      VARCHAR(20) NOT NULL,
    fk_id_turma      INT  NOT NULL,
    data_matricula   DATE NOT NULL,
    valor_matricula  DECIMAL(10,2) NOT NULL,
    CONSTRAINT pk_matricula PRIMARY KEY (pk_id_matricula),
    CONSTRAINT fk_mat_aluno FOREIGN KEY (fk_ra_aluno) REFERENCES tb_aluno (ra),
    CONSTRAINT fk_mat_turma FOREIGN KEY (fk_id_turma) REFERENCES tb_turma (pk_id_turma)
);

-- 7. DESEMPENHO E GRADE (ESTRUTURA ANALÍTICA / BI)
CREATE TABLE dim_aluno (
    sk_aluno INT AUTO_INCREMENT PRIMARY KEY,
    ra VARCHAR(20),
    nome_completo VARCHAR(255)
);

CREATE TABLE dim_curso (
    sk_curso INT AUTO_INCREMENT PRIMARY KEY,
    nome_curso VARCHAR(150)
);

CREATE TABLE dim_tempo (
    sk_tempo INT AUTO_INCREMENT PRIMARY KEY,
    data_completa DATE,
    ano INT,
    mes INT,
    dia INT
);

CREATE TABLE fato_financeiro (
    fk_aluno INT,
    fk_curso INT,
    fk_tempo INT,
    valor_matricula DECIMAL(10,2),
    FOREIGN KEY (fk_aluno) REFERENCES dim_aluno(sk_aluno),
    FOREIGN KEY (fk_curso) REFERENCES dim_curso(sk_curso),
    FOREIGN KEY (fk_tempo) REFERENCES dim_tempo(sk_tempo)
);

-- 8. OTIMIZAÇÃO (PERFORMANCE)
CREATE INDEX idx_pessoa_cpf ON tb_pessoa(cpf);
CREATE INDEX idx_matricula_aluno ON tb_matricula(fk_ra_aluno);
